# Server port
PORT=5000

# MongoDB connection string.
# Option A (Atlas, SRV) - works where DNS supports SRV records:
# MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/send-everywhere
#
# Option B (Atlas, direct / non-SRV) - use this if deployment fails with
# "querySrv EREFUSED" / "querySrv ENOTFOUND" (some platforms block SRV DNS):
# MONGO_URI=mongodb://USER:PASSWORD@shard-00-00.xxxxx.mongodb.net:27017,shard-00-01.xxxxx.mongodb.net:27017,shard-00-02.xxxxx.mongodb.net:27017/send-everywhere?ssl=true&replicaSet=atlas-xxxxx-shard-0&authSource=admin&retryWrites=true&w=majority
#
# Local development:
# MONGO_URI=mongodb://localhost:27017/send-everywhere
MONGO_URI=mongodb://localhost:27017/send-everywhere

# Frontend origin allowed by CORS
CLIENT_URL=http://localhost:5173

MAX_FILE_SIZE_MB=100
MAX_FILES_COUNT=10
# How long a share (and its stored files) stays alive.
# The cleanup cron deletes both the files and the database document once this
# elapses. The MongoDB TTL index on `expiresAt` is only a backstop for documents
# the cron missed, so it is granted an extra grace period of this many minutes.
EXPIRY_MINUTES=10

# Relative paths are resolved against the server/ directory.
UPLOAD_DIR=uploads

NODE_ENV=development
