PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB. Use a DIFFERENT MONGO_DB_NAME locally and in production so two
# servers never share one collection.
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=sendeverywhere_dev

MAX_TOTAL_SIZE_GB=3
MAX_FILE_SIZE_MB=100
MAX_FILES_COUNT=10

# Share lifetime after the upload is complete.
EXPIRY_MINUTES=10
# Max time a sender has to finish uploading (also the presigned PUT lifetime).
UPLOAD_WINDOW_MINUTES=60

# Filebase (S3-compatible). Docs list two endpoint/region pairs; if you get
# signature errors try https://s3.filebase.com + us-east-1.
FILEBASE_ENDPOINT=https://s3.filebase.io
FILEBASE_REGION=auto
FILEBASE_KEY=
FILEBASE_SECRET=
FILEBASE_BUCKET=
# Keeps dev and prod files apart inside one bucket (dev/ locally, prod/ on Render).
FILEBASE_KEY_PREFIX=dev/
# HEAD every object after deleting it to prove it is gone (recommended).
VERIFY_DELETE=true

NODE_ENV=development
